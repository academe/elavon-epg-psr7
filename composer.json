{
    "name": "academe/elavon-epg-psr7",
    "description": "PSR-7 messages and DTO classes for the Elavon Payment Gateway (EPG) API",
    "type": "library",
    "keywords": [
        "elavon",
        "epg",
        "payment",
        "gateway",
        "psr-7",
        "http",
        "message"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jason Judge",
            "email": "jason@academe.co.uk"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "7.5",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0|^11.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Academe\\Elavon\\Epg\\Psr7\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Academe\\Elavon\\Epg\\Psr7\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --testsuite Unit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration --exclude-group none",
        "test:all": "phpunit --exclude-group none",
        "phpstan": "phpstan analyse src --level=8",
        "cs-check": "phpcs --standard=PSR12 src tests",
        "cs-fix": "phpcbf --standard=PSR12 src tests"
    }
}
