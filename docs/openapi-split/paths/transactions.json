  "post": {
    "summary": "Create Transaction",
    "description": "Create a Transaction.",
    "tags": [
      "Transactions"
    ],
    "operationId": "CreateTransaction",
    "parameters": [
      {
        "$ref": "../components/parameters/Accept.json"
      },
