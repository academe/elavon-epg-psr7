# Elavon Payment Gateway Test Account Credentials
# These are used for integration tests against the Elavon UAT/sandbox environment

# Merchant credentials
ELAVON_MERCHANT_ALIAS=your_test_merchant_alias

# API Secret Key (required for transaction operations)
# This is different from the public API key - use the secret key from your Elavon dashboard
ELAVON_API_SECRET=your_test_api_secret

# Legacy: ELAVON_API_KEY is still supported for backwards compatibility
# ELAVON_API_KEY=your_test_api_key

# API Base URL
# EU UAT/Test: https://uat.api.converge.eu.elavonaws.com
# EU Production: https://api.eu.elavonpayments.com
ELAVON_BASE_URI=https://uat.api.converge.eu.elavonaws.com
