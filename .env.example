# Elavon Payment Gateway Test Account Credentials
# These are used for integration tests against the Elavon UAT/sandbox environment

# Merchant credentials
ELAVON_MERCHANT_ALIAS=your_test_merchant_alias

# Elavon provides two types of API keys:
#
# 1. Secret API Key (sk_...):
#    - Required for all server-side operations (transactions, shoppers, etc.)
#    - Never expose in client-side code
#    - Used by integration tests
#
# 2. Public API Key (pk_...):
#    - Only for client-side hosted card operations (CORS-enabled)
#    - Safe to include in browser code
#    - Some response fields are suppressed when using public key

# Secret API Key - required for integration tests
ELAVON_API_SECRET=sk_your_secret_api_key

# Public API Key - only needed for client-side hosted card operations
# ELAVON_API_KEY=pk_your_public_api_key

# Region and Environment (preferred method)
# Region: eu (Europe) or us (United States)
# Environment: sandbox/test (UAT) or live (Production)
ELAVON_REGION=eu
ELAVON_ENVIRONMENT=sandbox

# Alternative: Direct base URI (overrides region/environment if set)
# EU UAT/Test: https://uat.api.converge.eu.elavonaws.com
# EU Production: https://api.eu.convergepay.com
# US UAT/Test: https://uat.api.convergepay.com
# US Production: https://api.convergepay.com
# ELAVON_BASE_URI=https://uat.api.converge.eu.elavonaws.com
